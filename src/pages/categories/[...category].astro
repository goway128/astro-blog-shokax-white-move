---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { currentLocale, getT } from "@/i18n";
import { toCategoryHref, toPostHref } from "@/toolkit/posts/url";
import "../../styles/collapse.css";

export async function getStaticPaths() {
  const allPosts = await getCollection("posts");
  const publishedPosts = allPosts.filter((post) => !post.data.draft);

  const categoryPaths = new Map<string, string[]>();
  publishedPosts.forEach((post) => {
    const categories = post.data.categories || [];
    categories.forEach((_cat, index) => {
      const path = categories.slice(0, index + 1);
      categoryPaths.set(path.join("\u0000"), path);
    });
  });

  // Generate paths for each category
  return Array.from(categoryPaths.values()).map((categoryPath) => ({
    params: { category: categoryPath.join("/") },
    props: { categoryPath },
  }));
}

const { categoryPath } = Astro.props as { categoryPath: string[] };
const category = categoryPath.at(-1) ?? "";
const t = getT(currentLocale);

// Get all published posts
const allPosts = await getCollection("posts");
const publishedPosts = allPosts.filter((post) => !post.data.draft);

// 仅匹配完整分类路径，避免不同父分类下的同名子分类互相合并。
const postsInCategory = publishedPosts.filter((post) => {
  const categories = post.data.categories || [];
  return categoryPath.every((segment, index) => categories[index] === segment);
});

// Sort posts by date ascending (older first, matching old project)
const sortedPosts = postsInCategory.toSorted(
  (a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime(),
);

// Build parent categories breadcrumb
const parentCategories = categoryPath.slice(0, -1);

// Group posts by their full subcategory path for rendering sections
interface PostDisplay {
  post: (typeof sortedPosts)[0];
  subcategoryPath: string[];
  subcategorySlug: string;
}

const postDisplays: PostDisplay[] = [];

sortedPosts.forEach((post) => {
  const categories = post.data.categories || [];
  const currentIndex = categoryPath.length - 1;

  if (currentIndex >= 0) {
    // Build subcategory path (categories after current one)
    const subcategoryPath = categories.slice(currentIndex + 1);
    const subcategorySlug = subcategoryPath
      .map((c) => c.toLowerCase().replaceAll(/\s+/g, "-"))
      .join("-");

    postDisplays.push({
      post,
      subcategoryPath,
      subcategorySlug,
    });
  }
});

function formatDate(date: Date): string {
  const month = String(date.getUTCMonth() + 1).padStart(2, "0");
  const day = String(date.getUTCDate()).padStart(2, "0");
  return `${month}-${day}`;
}

// Track current subcategory slug to insert section headers
let currentSlug = "c";
---

<Layout pageTitle={category}>
  <div class="wrap">
    <div class="timeline">
      <h2 class="item header">
        <a href="/categories/">{t("category.all")}</a>
        {
          parentCategories.map((parent, index) => (
            <>
              <small>/</small>
              <a href={toCategoryHref(parentCategories.slice(0, index + 1))}>
                {parent}
              </a>
            </>
          ))
        }
        <small>/</small>
        {category}
        <small>{t("category.label")}</small>
      </h2>

      {
        postDisplays.map((display) => {
          const { post, subcategoryPath, subcategorySlug } = display;
          const needsHeader =
            subcategoryPath.length > 0 && subcategorySlug !== currentSlug;

          if (needsHeader) {
            currentSlug = subcategorySlug;
          }

          return (
            <>
              {needsHeader && (
                <h3 class="item section">
                  {subcategoryPath.map((cat, index) => (
                    <>
                      <a href={toCategoryHref([...categoryPath, ...subcategoryPath.slice(0, index + 1)])}>
                        {cat}
                      </a>
                      {index < subcategoryPath.length - 1 && <small>/</small>}
                    </>
                  ))}
                </h3>
              )}

              <article
                class="item normal"
                itemscope
                itemtype="http://schema.org/Article"
              >
                <div class="meta">
                  <time
                    itemprop="dateCreated"
                    datetime={post.data.date.toISOString()}
                  >
                    {formatDate(post.data.date)}
                  </time>
                </div>
                <div class="title">
                  <a href={toPostHref(post.id)} itemprop="url">
                    <span itemprop="name">{post.data.title || t("category.untitled")}</span>
                  </a>
                </div>
              </article>
            </>
          );
        })
      }

      {
        sortedPosts.length === 0 && (
          <div class="empty-state">
            <p>{t("category.noContent")}</p>
          </div>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .empty-state {
    text-align: center;
    padding: 3rem;
    color: var(--grey-5);
  }
</style>
